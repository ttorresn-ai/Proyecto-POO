<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.UNAL.views.LoginControlador" prefHeight="250.0" prefWidth="350.0">
    <children>
        <Label layoutX="30.0" layoutY="40.0" text="Email:" />
        <TextField fx:id="emailField" layoutX="120.0" layoutY="35.0" prefWidth="180.0"/>
        <Label layoutX="30.0" layoutY="90.0" text="Contraseña:" />
        <PasswordField fx:id="passwordField" layoutX="120.0" layoutY="85.0" prefWidth="180.0"/>
        <Button text="Iniciar Sesión" layoutX="120.0" layoutY="140.0" onAction="#handleLogin"/>
        <Button text="Registrarse" layoutX="220.0" layoutY="140.0" onAction="#handleRegister"/>
        <Label fx:id="msgLabel" layoutX="30.0" layoutY="190.0" textFill="red"/>
    </children>
</AnchorPane>