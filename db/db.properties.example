# URL de conexión MySQL. Incluye useSSL=false para entornos locales.
db.url=jdbc:mysql://localhost:3306/nexus_finance?useSSL=false&serverTimezone=America/Bogota&allowPublicKeyRetrieval=true

# Credenciales
