        <mxCell id="notaTrigger" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;align=left;verticalAlign=top;fontFamily=Courier New;spacingLeft=8;spacingTop=6;labelBackgroundColor=none;sketch=1;curveFitting=1;jiggle=2;fillColor=#FAE5C7;strokeColor=#0F8B8D;fontColor=#143642;" value="REGLA DE NEGOCIO (no expresable con PK/FK)&#xa;&#xa;&quot;No se pueden registrar movimientos con más de 90 días de antigüedad&quot;&#xa;&#xa;MySQL prohíbe funciones no deterministas (CURDATE) dentro de CHECK:&#xa;ERROR 3814: disallowed function: curdate&#xa;&#xa;Implementación: trigger BEFORE INSERT&#xa;trg_transacciones_fecha_limita&#xa;→ SIGNAL SQLSTATE &#39;45000&#39;" vertex="1">
